    "cves",
    "dacite",
    "dataframe",
    "dataframes",
    "datascan",
    "dateutil",
    "debugtoolbar",
    "domcontentloaded",
    "epss",
    "excinst",
    "Excludable",
    "exctb",
    "exctype",
    "exploitability",
    "fastapi",
    "firebounty",
    "fprompts",
    "fqdns",
    "getservbyname",
    "getservbyport",
    "healthcheck",
    "healthchecks",
    "hostnames",
    "ilike",
    "innerprocessors",
    "isin",
    "isna",
    "isodate",
    "iterrows",
    "jsonlogger",
    "jsonschema",
    "keypair",
    "maxscantime",
    "maxsplit",
    "minictf",
    "modelview",
    "modname",
    "mypy",
    "nettype",
    "nmap",
    "noscan",
    "notna",
    "Nslookup",
    "ONDEMAND",
    "onupdate",
    "ONYPHE",
    "pentest",
    "pinauth",
    "pinsalt",
    "portstr",
    "Postg",
    "prefixlen",
    "prioritizer",
    "productvendor",
    "productversion",
    "Purplemet",
    "pydantic",
    "pythonjsonlogger",
    "rescan",
    "Sakii",
    "sakiir",
    "secreq",
    "SECTRAILS",
    "Securitytrails",
    "Sekhost",
    "Sekost",
    "sessionmaker",
    "setrecursionlimit",
    "signale",
    "SIGTERM",
    "softdelete",
    "sqlalchemy",
    "sqltypes",
    "supersecretuser",
    "synscan",
    "tdelta",
    "typer",
    "unarchiving",
    "Uploadify",
    "urandom",
    "urlscan",
    "uvicorn",
    "vfeed",
    "vulnpedia",
    "vulnscan",
    "werkzeug",
    "whois",
    "zerodisclo"
  ],
  "[python]": {
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.unusedImports": "explicit"
    },
  },
  "terminal.integrated.env.linux": {},
  "terminal.integrated.env.windows": {},
  "gitlens.remotes": [
    {
      "domain": "git.clacos.ninja",
      "type": "GitLab"
    }
  ],
  "terminal.integrated.fontFamily": "Monaspace Krypton",
  "terminal.integrated.persistentSessionScrollback": 10000,
  "terminal.integrated.scrollback": 10000,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "workbench.colorTheme": "Andromeda",
  "python.analysis.typeCheckingMode": "basic",
  "go.toolsManagement.autoUpdate": true,
  "atlascode.rovodev.showEntitlementNotifications": false,
  "gitlens.ai.generateCommitMessage.customInstructions": "To generate the prompt, make sure you follow conventional-commit and add the jira issue number as prefix. Example: PROJ-123 feat(auth): the commit message. Where feat is the type fix, docs, etc as described in https://www.conventionalcommits.org. You can retrieve the jira issue number from the current branch name. types other than fix: and feat: are allowed, for example @commitlint/config-conventional (based on the Angular convention) recommends build:, chore:, ci:, docs:, style:, refactor:, perf:, test:, and others.",
  "gitlens.ai.model": "anthropic:claude-3-5-sonnet-latest",
  "files.insertFinalNewline": true,
  "docker.extension.enableComposeLanguageServer": false,
  "git.ignoreRebaseWarning": true,
  "python.languageServer": "Default",
  "ty.completions.autoImport": true,
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/__pycache__/**": true
  }
}
